{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["./assets/*"],
      "@components/*": ["./components/*"],
      "@constants/*": ["./constants/*"],
      "@screens/*": ["./screens/*"],
      "@utils/*": ["./utils/*"],
      "@styles/*": ["./styles/*"],
      "@icons/*": ["./icons/*"],
      "@hooks/*": ["./hooks/*"],
      "@assets": ["./assets"],
      "@components": ["./components"],
      "@constants": ["./constants"],
      "@screens": ["./screens"],
      "@utils": ["./utils"],
      "@styles": ["./styles"],
      "@icons": ["./icons"],
      "@hooks": ["./hooks"]
    }
  }
}
