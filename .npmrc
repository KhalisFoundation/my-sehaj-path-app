# Auth for the private npm package (npmjs.org, private scoped package).
#
# The token is read from the NPM_TOKEN environment variable — it is NOT stored
# in this file, so this file is safe to commit and share.
#
# Yarn classic defaults to registry.yarnpkg.com (a mirror that does NOT serve
# private packages), so the @sikhi-ui scope must be pinned to registry.npmjs.org
# — the same host the auth token below is bound to.
@sikhi-ui:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
always-auth=true
