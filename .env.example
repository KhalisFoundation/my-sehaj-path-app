# Copy to .env and set per environment.
# API base URL, e.g. https://<sehaj-api-host>
SEHAJ_API_URL= ""

# Keep true in production. Set false only for QA builds that need to edit a
# turn into the next 15 minutes. This is a UI-only compatibility flag.
SEHAJ_PATH_ENFORCE_EDIT_BOOKING_LEAD_TIME=true

# Khalis SSO Service Provider base URL.
SSO_SERVICE_URL=https://serviceprovider.khalis.net

# Khalis SSO identity provider base URL. Account deletion lives here,
# not on the service provider.
SSO_IDP_URL=""
